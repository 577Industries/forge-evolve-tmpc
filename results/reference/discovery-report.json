    "BusinessRules": [
      {
        "Id": "rule-01-great-circle-leg-distance",
        "Category": "Calculation",
        "Statement": "Each leg distance is the great-circle distance between consecutive waypoints, scaled by the Earth radius constant (3440.065 nm).",
        "Expression": "legDistanceNm = EARTH_RADIUS_NM * sqrt(dLatRad^2 \u002B (cos(meanLat)*dLonRad)^2)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.92
      },
      {
        "Id": "rule-02-total-distance-sum",
        "Category": "Calculation",
        "Statement": "Total route distance is the sum of all per-leg distances.",
        "Expression": "totalDistanceNm = sum(legDistancesNm)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.9
      },
      {
        "Id": "rule-03-estimated-time-on-target",
        "Category": "Calculation",
        "Statement": "Estimated time-on-target is the launch epoch plus travel time at the nominal speed (0.15 nm/s), plus any synthetic leap seconds crossed.",
        "Expression": "estimatedTotEpochSec = launchEpochSec \u002B travelTime(totalDistanceNm, 0.15) \u002B leapSeconds(launch, tot)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.85
      },
      {
        "Id": "rule-04-anti-meridian-wrap",
        "Category": "Calculation",
        "Statement": "Longitude deltas are normalized to [-180, 180] before use so legs crossing the \u002B/-180 anti-meridian are measured correctly.",
        "Expression": "dLon = wrapTo180(lon2 - lon1)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.WrapDlon"
        ],
        "Confidence": 0.9
      },
      {
        "Id": "rule-05-leg-degree-box-feasibility",
        "Category": "Validation",
        "Statement": "A leg is feasible only if |dLatDeg| \u003C= MaxLegDLatDeg (22.0) and the wrapped |dLonDeg| \u003C= MaxLegDLonDeg (22.0) \u2014 a coarse leg-length feasibility proxy.",
        "Expression": "abs(dLatDeg) \u003C= 22.0 AND abs(wrap(dLonDeg)) \u003C= 22.0",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.9
      },
      {
        "Id": "rule-06-turn-rate-limit",
        "Category": "Validation",
        "Statement": "The turn angle between consecutive legs must not exceed MaxTurnDeg (120 degrees).",
        "Expression": "turnAngle(bearing[i], bearing[i\u002B1]) \u003C= 120.0",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission",
          "Tmpc.Surrogate.Legacy.MissionProcessor.TurnAngleDeg"
        ],
        "Confidence": 0.9
      },
      {
        "Id": "rule-07-tot-tolerance",
        "Category": "Validation",
        "Statement": "A route is time-on-target feasible only if |estimatedTot - desiredTot| \u003C= TotTolSec (120 seconds).",
        "Expression": "abs(estimatedTotEpochSec - desiredTotEpochSec) \u003C= 120",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.9
      },
      {
        "Id": "rule-08-route-validity-aggregate",
        "Category": "Validation",
        "Statement": "A route is valid only if every leg passes the degree-box check and every turn passes the turn-rate limit.",
        "Expression": "routeValid = forall legs (inBox) AND forall turns (\u003C= 120)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.85
      },
      {
        "Id": "rule-09-sequential-waypoint-legs",
        "Category": "Routing",
        "Statement": "Legs are formed between consecutive waypoints in order; a route requires at least two waypoints.",
        "Expression": "legs = [(wp[i], wp[i\u002B1]) for i in 0..n-2]; n \u003E= 2",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.85
      },
      {
        "Id": "rule-10-mst-surface-only-tasking",
        "Category": "Constraint",
        "Statement": "Tasking is GO only if the route is valid AND the mission is not an MST variant on an SSN (submarine) platform; MST is surface-only.",
        "Expression": "taskingGoNoGo = routeValid AND NOT (variant == \u0027MST\u0027 AND platform == \u0027SSN\u0027)",
        "SourceRefs": [
          "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission"
        ],
        "Confidence": 0.93
      },
      {
        "Id": "rule-11-weapon-max-range-by-variant",
        "Category": "Constraint",
        "Statement": "Each variant has a maximum weapon range: BlockIV 900 nm, BlockV 1000 nm, MST 1000 nm.",
        "Expression": "weaponMaxRangeNm = { BlockIV: 900, BlockV: 1000, MST: 1000 }",
        "SourceRefs": [
          "js:mission-review"
        ],
        "Confidence": 0.85
      },
