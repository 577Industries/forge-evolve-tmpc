# business-rules.ttl — rules extracted by the FORGE EVOLVE Discovery engine
# from the synthetic, unclassified surrogate. Scored (F1) against
# surrogate/gold/business-rules.gold.ttl. Deterministic; no timestamps.

@prefix fe:   <https://577industries.com/forge-evolve/ns#> .
@prefix rule: <https://577industries.com/forge-evolve/surrogate/rule#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

rule:rule_01_great_circle_leg_distance a fe:BusinessRule ;
    fe:category "Calculation" ;
    rdfs:label "rule-01-great-circle-leg-distance" ;
    fe:statement "Each leg distance is the great-circle distance between consecutive waypoints, scaled by the Earth radius constant (3440.065 nm)." ;
    fe:confidence "0.920" ;
    fe:expression "legDistanceNm = EARTH_RADIUS_NM * sqrt(dLatRad^2 + (cos(meanLat)*dLonRad)^2)" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_02_total_distance_sum a fe:BusinessRule ;
    fe:category "Calculation" ;
    rdfs:label "rule-02-total-distance-sum" ;
    fe:statement "Total route distance is the sum of all per-leg distances." ;
    fe:confidence "0.900" ;
    fe:expression "totalDistanceNm = sum(legDistancesNm)" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_03_estimated_time_on_target a fe:BusinessRule ;
    fe:category "Calculation" ;
    rdfs:label "rule-03-estimated-time-on-target" ;
    fe:statement "Estimated time-on-target is the launch epoch plus travel time at the nominal speed (0.15 nm/s), plus any synthetic leap seconds crossed." ;
    fe:confidence "0.850" ;
    fe:expression "estimatedTotEpochSec = launchEpochSec + travelTime(totalDistanceNm, 0.15) + leapSeconds(launch, tot)" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_04_anti_meridian_wrap a fe:BusinessRule ;
    fe:category "Calculation" ;
    rdfs:label "rule-04-anti-meridian-wrap" ;
    fe:statement "Longitude deltas are normalized to [-180, 180] before use so legs crossing the +/-180 anti-meridian are measured correctly." ;
    fe:confidence "0.900" ;
    fe:expression "dLon = wrapTo180(lon2 - lon1)" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.WrapDlon" .

rule:rule_05_leg_degree_box_feasibility a fe:BusinessRule ;
    fe:category "Validation" ;
    rdfs:label "rule-05-leg-degree-box-feasibility" ;
    fe:statement "A leg is feasible only if |dLatDeg| <= MaxLegDLatDeg (22.0) and the wrapped |dLonDeg| <= MaxLegDLonDeg (22.0) — a coarse leg-length feasibility proxy." ;
    fe:confidence "0.900" ;
    fe:expression "abs(dLatDeg) <= 22.0 AND abs(wrap(dLonDeg)) <= 22.0" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_06_turn_rate_limit a fe:BusinessRule ;
    fe:category "Validation" ;
    rdfs:label "rule-06-turn-rate-limit" ;
    fe:statement "The turn angle between consecutive legs must not exceed MaxTurnDeg (120 degrees)." ;
    fe:confidence "0.900" ;
    fe:expression "turnAngle(bearing[i], bearing[i+1]) <= 120.0" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.TurnAngleDeg" .

rule:rule_07_tot_tolerance a fe:BusinessRule ;
    fe:category "Validation" ;
    rdfs:label "rule-07-tot-tolerance" ;
    fe:statement "A route is time-on-target feasible only if |estimatedTot - desiredTot| <= TotTolSec (120 seconds)." ;
    fe:confidence "0.900" ;
    fe:expression "abs(estimatedTotEpochSec - desiredTotEpochSec) <= 120" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_08_route_validity_aggregate a fe:BusinessRule ;
    fe:category "Validation" ;
    rdfs:label "rule-08-route-validity-aggregate" ;
    fe:statement "A route is valid only if every leg passes the degree-box check and every turn passes the turn-rate limit." ;
    fe:confidence "0.850" ;
    fe:expression "routeValid = forall legs (inBox) AND forall turns (<= 120)" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_09_sequential_waypoint_legs a fe:BusinessRule ;
    fe:category "Routing" ;
    rdfs:label "rule-09-sequential-waypoint-legs" ;
    fe:statement "Legs are formed between consecutive waypoints in order; a route requires at least two waypoints." ;
    fe:confidence "0.850" ;
    fe:expression "legs = [(wp[i], wp[i+1]) for i in 0..n-2]; n >= 2" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_10_mst_surface_only_tasking a fe:BusinessRule ;
    fe:category "Constraint" ;
    rdfs:label "rule-10-mst-surface-only-tasking" ;
    fe:statement "Tasking is GO only if the route is valid AND the mission is not an MST variant on an SSN (submarine) platform; MST is surface-only." ;
    fe:confidence "0.930" ;
    fe:expression "taskingGoNoGo = routeValid AND NOT (variant == 'MST' AND platform == 'SSN')" ;
    fe:sourceRef "Tmpc.Surrogate.Legacy.MissionProcessor.ProcessMission" .

rule:rule_11_weapon_max_range_by_variant a fe:BusinessRule ;
    fe:category "Constraint" ;
    rdfs:label "rule-11-weapon-max-range-by-variant" ;
    fe:statement "Each variant has a maximum weapon range: BlockIV 900 nm, BlockV 1000 nm, MST 1000 nm." ;
    fe:confidence "0.850" ;
    fe:expression "weaponMaxRangeNm = { BlockIV: 900, BlockV: 1000, MST: 1000 }" ;
    fe:sourceRef "js:mission-review" .

rule:rule_12_max_leg_length a fe:BusinessRule ;
    fe:category "Constraint" ;
    rdfs:label "rule-12-max-leg-length" ;
    fe:statement "A single leg may not exceed MaxLegNm (1500 nm); the degree-box check is the coarse proxy enforcing this near the equator." ;
    fe:confidence "0.800" ;
    fe:expression "legDistanceNm <= 1500" ;
    fe:sourceRef "LegacyConfig" .

