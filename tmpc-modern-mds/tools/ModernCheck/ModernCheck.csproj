<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModernCheck — THE BEHAVIORAL-EQUIVALENCE PROOF for the modernized mission component.

    Replays the frozen golden corpus (surrogate/corpus/corpus.json) through the modern
    MissionService.ProcessMission and asserts its output EQUALS the stored Python `legacyOutput`
    answer key: discrete fields (missionId, routeValid, totFeasible, taskingGoNoGo,
    estimatedTotEpochSec, messages, leg count) EXACT; continuous distance fields within 1e-9
    relative. Prints "MODERN-CHECK PASS: N/N" and exits 0 on success; otherwise lists mismatches
    and exits 1. This proves the modern component reproduces the legacy D1/D2/D3 behavior exactly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ForgeEvolve.ModernMds.Tools</RootNamespace>
    <AssemblyName>ModernCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ForgeEvolve.ModernMds.csproj" />
  </ItemGroup>

</Project>
